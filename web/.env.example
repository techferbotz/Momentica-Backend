# The API the renderer fetches from. In production this is the backend's
# loopback port on the same box — every share link is `no-store`, so SSR calls
# the API on every request and ~1ms beats ~100ms.
API_BASE=https://momentica.ferbotz.com/api

# The public hostname. Used to absolutise og:image, which must be absolute or
# no preview card renders at all. NOT the same as API_BASE in production.
PUBLIC_ORIGIN=https://momentica.ferbotz.com

# How long to wait on the API before drawing the "can't load this" page.
API_TIMEOUT_MS=5000

# Where the expired page's renew prompt sends a creator. Left unset until the
# app is listed — an unset value renders the page with no button rather than a
# button that goes nowhere.
# APP_STORE_URL=
