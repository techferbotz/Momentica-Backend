---
import RenderRoute from '../components/RenderRoute.astro';
import { resolveRoute } from '../lib/route';

/**
 * The route. Every share link lands here.
 *
 *   pv_<templateId>   feed preview, from the template's sample data
 *   d_<jwt>           the creator's own draft, before payment
 *   <8 base62 chars>  a published, paid link
 *
 * One fetch, one render path, no branching on which of the three it is. The
 * code's shape is the API's business, not this file's.
 */
const code = Astro.params.code ?? '';
const outcome = await resolveRoute(code);

Astro.response.status = outcome.status;
Astro.response.headers.set('Cache-Control', outcome.cacheControl);
// The renderer sets its own headers rather than passing the API's through —
// the API sends `public, max-age=300` even on 404s, which would pin a
// just-published link as dead for five minutes.
Astro.response.headers.set('X-Content-Type-Options', 'nosniff');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
// Only present on a 503: the API was unreachable, which is worth retrying.
// A 404 is not, and a Retry-After there would invite crawlers to keep asking.
if (outcome.retryAfterSeconds) {
  Astro.response.headers.set('Retry-After', String(outcome.retryAfterSeconds));
}
---

<RenderRoute outcome={outcome} />
