# The web renderer. Build context is the REPO ROOT, not web/ — the renderer's
# template manifest imports the API's template registry as a value, so the
# backend's src/ has to be present at build time. Nothing from it survives into
# the runner: Vite bundles what it needs into the server output.

# ---- builder -------------------------------------------------------------
FROM node:22-slim AS builder
WORKDIR /app

COPY web/package*.json ./web/
RUN cd web && npm ci

# The backend source, for the @api/* path alias. Build-time only.
COPY src ./src
COPY web ./web

RUN cd web && npm run build

# Drop dev dependencies from the tree we are about to copy across.
RUN cd web && npm prune --omit=dev

# ---- runner --------------------------------------------------------------
FROM node:22-slim AS runner
WORKDIR /app/web
ENV NODE_ENV=production

# Astro's node adapter binds to HOST:PORT. 0.0.0.0 so the container is
# reachable from the compose network; nginx on the host is still the only
# public entry point, via a loopback-published port.
ENV HOST=0.0.0.0
ENV PORT=4321

COPY --from=builder /app/web/node_modules ./node_modules
COPY --from=builder /app/web/dist ./dist
COPY --from=builder /app/web/package.json ./package.json

# node:22-slim ships an unprivileged `node` user; use it.
USER node

EXPOSE 4321
CMD ["node", "./dist/server/entry.mjs"]
